# Values whose reading differs between naive parsers; tests/compose/EnvParity.Tests.ps1 reads this file both ways.
K1=plain
EMPTY=
K2="C:\dev\platform"
K3='it\'s'
K4=${K1}_x
K5=$$x
K6="a\x41"
K7="\0101"
K8=val	#tab
K9: yaml
9K=digit
K10="quoted" trailing
K12="a\\b"
K13="tab\tx"
K14='single $x \n'
K15="$K1"
K17=${UNSET_PARITY:-def}
K18="a\"b"
K19=   spaced value   
export K20=e
K21=a #c
K22="\c"
K23=\n
K24="\'"
K25='a\\b'
K26=${UNSET_PARITY-dash}
K27=${EMPTY:-colon}
K28=${EMPTY-dash}
K29="${K1:+set}"
K30=${UNSET_PARITY:-${K1}}
K31="cost\$5"
K32=$K1.z
K33=${SL_PARITY_ONLY_OS}_y
K34=${SL_PARITY_BOTH}_x
SL_PARITY_BOTH=fromfile
