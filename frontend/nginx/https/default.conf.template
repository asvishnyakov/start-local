server {
    listen       8080 ssl;
    server_name  localhost;

    # The development certificate from the certificates volume. Proxying to the platform does not verify the
    # platform's certificate (nginx's proxy_ssl_verify is off by default). The upstream is the platform container,
    # or with frontend-hostplatform.yml the platform on the host; both normally serve the local dev certificate.
    ssl_certificate     /certs/dev/localhost.pem;
    ssl_certificate_key /certs/dev/localhost.key;

    include /etc/nginx/conf.d/snippets/storefront.conf;
}
