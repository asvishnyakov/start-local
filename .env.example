# --- Stack: maintained by the scripts ---
START_LOCAL_LAYOUT=2
# release tag or branch of the installed payload
START_LOCAL_REF=
# the same file works on Windows and Linux
COMPOSE_PATH_SEPARATOR=;
# empty: the installer asks for the DB provider and lists the defaults, docker-compose/https.yml included
COMPOSE_FILE=
# empty: the project (folder) name; migrated folders: virto
VOLUME_PREFIX=
# 0.0.0.0 allows access from other machines
BIND_ADDRESS=127.0.0.1

# --- Shared services ---
# empty: a standalone stack; services: the servers only; platform: a platform that uses a services stack
STACK_ROLE=
# platform: the services stack's folder, absolute or relative to this folder
SERVICES_FOLDER=
# platform: the one name of this platform, a single label before .dev.internal; empty: <project name>.dev.internal
PLATFORM_HOSTNAME=
# platform in Docker: ;-separated PLATFORM_HOSTNAMEs of the platforms it calls that run from source
PEER_PLATFORMS_FROM_SOURCE=
# the database name; empty: VirtoCommerce3, or VirtoCommerce_<project name> in a platform stack
DB_NAME=
# the search index prefix (Search:Scope); empty: the platform's default, or the project name in a platform stack
SEARCH_SCOPE=
# the Redis channel of the cache and the push notifications; empty: VirtoCommerceChannel, or VirtoCommerceChannel-<project name> in a platform stack
REDIS_CHANNEL=
# the Redis database index; empty: 0, or the lowest free one in a platform stack
REDIS_DATABASE=
# ;-separated certificate files the platform trusts besides the container's own, for example a local CA
EXTRA_CA_CERTS=

# --- Solution ---
# stable | stable:<N> | edge | custom; asked once when empty
RELEASE_CHANNEL=
# custom: path or URL of the package manifest
CUSTOM_PACKAGES_JSON=
# custom: storefront ZIP; empty = latest vc-frontend release
CUSTOM_FRONTEND_URL=
# ElasticSearch9 once that module is installed
SEARCH_PROVIDER=ElasticSearch8
# non-interactive runs set the admin password to it, generating one when empty; change it in the platform first (README)
ADMIN_PASSWORD=

# --- Run from source (empty = Docker) ---
# vc-platform checkout or prebuilt platform folder
PLATFORM_SOURCE_PATH=
# ;-separated module *.Web folders, or one modules folder
MODULE_SOURCE_PATHS=
# true: no platform runs at all, Docker or source; you run it yourself (a source platform is still prepared)
SKIP_PLATFORM=

# --- Versions, ports, limits ---
PGSQL_VERSION=18.3
PGSQL_PORT=5432
MYSQL_VERSION=9.3
MYSQL_PORT=3306
MSSQL_VERSION=2022-latest
MSSQL_PORT=1433
STACK_VERSION=9.5.5
ES_PORT=9200
KIBANA_PORT=5601
ES_MEM_LIMIT=1g
REDIS_PORT=6379
PLATFORM_PORT=8090
FRONTEND_PORT=443

# --- Secrets: filled at install when empty, never rotated ---
DB_PASSWORD=
REDIS_PASSWORD=
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
